rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
//  AnabolicOS — règles de sécurité Firestore
//
//  Principes :
//   • Chaque utilisateur ne voit et ne modifie QUE ses propres données.
//   • L'admin est défini par un document admins/{uid} créé à la main dans
//     la console Firebase. Aucun client ne peut écrire dans /admins.
//   • Un compte désactivé (users/{uid}.status == 'disabled') ne peut plus
//     lire ni écrire ses données. Rien n'est supprimé.
//   • Tout ce qui n'est pas explicitement autorisé est refusé.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isActive(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function ownerActive(uid) {
      return isOwner(uid) && isActive(uid);
    }
    // Vrai si la mise à jour ne touche QUE les champs listés.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }
    // Identifiant d'amitié : les deux uid triés, joints par « _ ».
    function pairOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    // Ami = amitié ACCEPTÉE (une demande en attente ne donne accès à rien).
    // Les amitiés créées avant les demandes (sans statut) comptent comme acceptées.
    function isFriend(uid) {
      return signedIn()
        && get(/databases/$(database)/documents/friendships/$(pairOf(request.auth.uid, uid))).data.get('status', 'accepted') == 'accepted';
    }
    function friendshipAccepted(pid) {
      return get(/databases/$(database)/documents/friendships/$(pid)).data.get('status', 'accepted') == 'accepted';
    }
    // Activité visible par les amis (+ dernière publication et version de la photo).
    function isActivity(d) {
      return d.get('lastPost', {}) is map
        && d.get('avatarAt', 0) is int
        && d.get('lastPost', {}).size() <= 12
        && d.keys().hasOnly(['name', 'day', 'sessionName', 'at', 'lastPost', 'avatarAt']);
    }
    // Publication « record » partagée avec les amis.
    function isPrPost(d) {
      return d.type == 'pr'
        && d.w is number
        && d.r is int
        && d.keys().hasOnly(['type', 'name', 'exercise', 'w', 'r', 'e1rm', 'at', 'likes'])
        && isShortString(d.exercise, 120);
    }
    // Publication « musique » : lien https vers Spotify / Deezer / Apple Music uniquement.
    // (« service » est un mot réservé des règles → accès par d['service'])
    function isMusicPost(d) {
      return d.type == 'music'
        && d.keys().hasOnly(['type', 'name', 'url', 'title', 'service', 'at', 'likes'])
        && d['service'] in ['spotify', 'deezer', 'apple']
        && isShortString(d.title, 120)
        && isShortString(d.url, 300)
        && d.url.matches('^https://(open[.]spotify[.]com|spotify[.]link|(www[.])?deezer[.]com|deezer[.]page[.]link|link[.]deezer[.]com|music[.]apple[.]com)/[^ ]*$');
    }
    function isMessage(data, from) {
      return data.keys().hasOnly(['from', 'text', 'at'])
        && data.from == from
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.at == request.time;
    }

    // ── Admins (lecture de son propre statut uniquement) ────────────────
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Profil racine de l'utilisateur ──────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Création au premier login : champs imposés, statut forcé à 'active'.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'createdAt', 'lastActiveAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && isShortString(request.resource.data.get('displayName', ''), 120);

      // L'utilisateur ne peut jamais toucher à son statut ;
      // l'admin ne peut toucher qu'au statut et à sa note.
      allow update: if
           (isOwner(uid)
             && resource.data.status == 'active'
             && onlyChanges(['displayName', 'photoURL', 'lastActiveAt', 'lastWeight', 'lastWeightAt', 'friendCode', 'avatarAt']))
        || (isAdmin()
             && onlyChanges(['status', 'adminNote'])
             && request.resource.data.status in ['active', 'disabled']);

      allow delete: if false;

      // Données métier (même chemins que l'ancienne app → import direct).
      match /data/{docId} {
        allow read: if ownerActive(uid) || isAdmin();
        allow write: if ownerActive(uid)
          || (isAdmin() && docId in ['workouts', 'diet', 'protocol', 'profiles', 'goals']);
      }

      // Cases cochées de la semaine.
      match /weeks/{weekId} {
        allow read: if ownerActive(uid) || isAdmin();
        allow write: if ownerActive(uid);
      }

      // Envois de l'admin (programme, diet, protocole, note).
      match /inbox/{itemId} {
        allow read: if ownerActive(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if (ownerActive(uid) && onlyChanges(['status', 'handledAt'])
                           && request.resource.data.status in ['accepted', 'dismissed'])
                      || isAdmin();
      }
    }

    // ── Messagerie : une conversation par utilisateur ───────────────────
    match /conversations/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // L'utilisateur peut :
      //  (a) poster (met à jour l'aperçu du dernier message, en tant que 'user')
      //  (b) marquer comme lu (userReadAt uniquement)
      // (c) l'admin peut ouvrir une conversation (premier message à un utilisateur)
      allow create: if isAdmin()
        || (ownerActive(uid)
            && request.resource.data.keys().hasOnly(
                 ['userName', 'lastText', 'lastFrom', 'lastAt', 'userReadAt', 'adminReadAt', 'status'])
            && request.resource.data.lastFrom == 'user'
            && request.resource.data.status == 'open');

      allow update: if isAdmin()
        || (ownerActive(uid) && onlyChanges(['userReadAt']))
        || (ownerActive(uid)
             && onlyChanges(['userName', 'lastText', 'lastFrom', 'lastAt', 'userReadAt', 'status'])
             && request.resource.data.lastFrom == 'user'
             && request.resource.data.status == 'open');

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time
          && ((ownerActive(uid) && request.resource.data.from == 'user')
              || (isAdmin() && request.resource.data.from == 'admin'));
        // Historique immuable.
        allow update, delete: if false;
      }
    }

    // ── Amis ────────────────────────────────────────────────────────────
    // Code ami : permet de retrouver un utilisateur. Lecture unitaire seulement
    // (impossible de lister les codes), création par son propriétaire.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isShortString(request.resource.data.name, 120);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Amitié : créée par l'un des deux, UNIQUEMENT avec le code de l'autre.
    match /friendships/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Demande d'ami : créée « en attente » par le demandeur, avec le code de l'autre.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'code', 'createdAt', 'status', 'requestedBy'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && pid == pairOf(request.resource.data.members[0], request.resource.data.members[1])
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid != request.auth.uid
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && (
          // (a) acceptation : seul le DESTINATAIRE de la demande peut accepter
          (resource.data.get('status', 'accepted') == 'pending'
            && request.resource.data.status == 'accepted'
            && request.auth.uid != resource.data.requestedBy
            && onlyChanges(['status', 'acceptedAt']))
          // (b) aperçu du dernier message / lecture, une fois amis
          || (resource.data.get('status', 'accepted') == 'accepted'
            && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'readAt'])
            && (request.resource.data.get('lastFrom', '') == resource.data.get('lastFrom', '')
                || request.resource.data.lastFrom == request.auth.uid))
        );
      // Refuser / annuler / retirer un ami : l'un ou l'autre peut supprimer.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && friendshipAccepted(pid);
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && friendshipAccepted(pid)
          && isMessage(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Activité visible par les amis (séance faite aujourd'hui).
    match /activity/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isFriend(uid);
      // lastPost : copie de la dernière publication (évite aux amis de lire les posts) ;
      // avatarAt : version de la photo (les amis ne la relisent que si elle change).
      allow write: if ownerActive(uid) && isActivity(request.resource.data);

      // Records et musiques partagés avec les amis, qui peuvent les « liker ».
      match /posts/{postId} {
        allow read: if isOwner(uid) || isAdmin() || isFriend(uid);
        allow create: if ownerActive(uid)
          && isShortString(request.resource.data.name, 120)
          && request.resource.data.likes is list
          && request.resource.data.likes.size() == 0
          && request.resource.data.at == request.time
          && (isPrPost(request.resource.data) || isMusicPost(request.resource.data));
        // Liker / retirer son like : seul son propre uid peut être ajouté ou retiré.
        allow update: if (isOwner(uid) || isFriend(uid))
          && onlyChanges(['likes'])
          && request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).hasOnly([request.auth.uid])
          && resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid]);
        allow delete: if isOwner(uid);
      }
    }

    // Liens utiles (Moi) : publics pour les connectés, privés pour l'admin.
    match /config/links {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items.size() <= 30;
    }
    match /config/linksPrivate {
      allow read, write: if isAdmin();
    }

    // Bibliothèque de programmes types : réservée à l'admin.
    match /library/{itemId} {
      allow read, write: if isAdmin();
    }

    // Photo de profil (JPEG compressé ≤ ~110 Ko), visible par les amis et l'admin.
    match /avatars/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isFriend(uid);
      allow write: if ownerActive(uid)
        && request.resource.data.keys().hasOnly(['img', 'at'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 150000
        && request.resource.data.img.matches('^data:image/jpeg;base64,.*');
      allow delete: if isOwner(uid);
    }
  }
}
