rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
//  AnabolicOS — règles de sécurité Firestore
//
//  Principes :
//   • Chaque utilisateur ne voit et ne modifie QUE ses propres données.
//   • L'admin est défini par un document admins/{uid} créé à la main dans
//     la console Firebase. Aucun client ne peut écrire dans /admins.
//   • Un compte désactivé (users/{uid}.status == 'disabled') ne peut plus
//     lire ni écrire ses données. Rien n'est supprimé.
//   • Tout ce qui n'est pas explicitement autorisé est refusé.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isActive(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function ownerActive(uid) {
      return isOwner(uid) && isActive(uid);
    }
    // Vrai si la mise à jour ne touche QUE les champs listés.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }
    // Identifiant d'amitié : les deux uid triés, joints par « _ ».
    function pairOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isMessage(data, from) {
      return data.keys().hasOnly(['from', 'text', 'at'])
        && data.from == from
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.at == request.time;
    }

    // ── Admins (lecture de son propre statut uniquement) ────────────────
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Profil racine de l'utilisateur ──────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Création au premier login : champs imposés, statut forcé à 'active'.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'createdAt', 'lastActiveAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && isShortString(request.resource.data.get('displayName', ''), 120);

      // L'utilisateur ne peut jamais toucher à son statut ;
      // l'admin ne peut toucher qu'au statut et à sa note.
      allow update: if
           (isOwner(uid)
             && resource.data.status == 'active'
             && onlyChanges(['displayName', 'photoURL', 'lastActiveAt', 'lastWeight', 'lastWeightAt', 'friendCode']))
        || (isAdmin()
             && onlyChanges(['status', 'adminNote'])
             && request.resource.data.status in ['active', 'disabled']);

      allow delete: if false;

      // Données métier (même chemins que l'ancienne app → import direct).
      match /data/{docId} {
        allow read: if ownerActive(uid) || isAdmin();
        allow write: if ownerActive(uid)
          || (isAdmin() && docId in ['workouts', 'diet', 'protocol', 'profiles']);
      }

      // Cases cochées de la semaine.
      match /weeks/{weekId} {
        allow read: if ownerActive(uid) || isAdmin();
        allow write: if ownerActive(uid);
      }

      // Envois de l'admin (programme, diet, protocole, note).
      match /inbox/{itemId} {
        allow read: if ownerActive(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if (ownerActive(uid) && onlyChanges(['status', 'handledAt'])
                           && request.resource.data.status in ['accepted', 'dismissed'])
                      || isAdmin();
      }
    }

    // ── Messagerie : une conversation par utilisateur ───────────────────
    match /conversations/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // L'utilisateur peut :
      //  (a) poster (met à jour l'aperçu du dernier message, en tant que 'user')
      //  (b) marquer comme lu (userReadAt uniquement)
      // (c) l'admin peut ouvrir une conversation (premier message à un utilisateur)
      allow create: if isAdmin()
        || (ownerActive(uid)
            && request.resource.data.keys().hasOnly(
                 ['userName', 'lastText', 'lastFrom', 'lastAt', 'userReadAt', 'adminReadAt', 'status'])
            && request.resource.data.lastFrom == 'user'
            && request.resource.data.status == 'open');

      allow update: if isAdmin()
        || (ownerActive(uid) && onlyChanges(['userReadAt']))
        || (ownerActive(uid)
             && onlyChanges(['userName', 'lastText', 'lastFrom', 'lastAt', 'userReadAt', 'status'])
             && request.resource.data.lastFrom == 'user'
             && request.resource.data.status == 'open');

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time
          && ((ownerActive(uid) && request.resource.data.from == 'user')
              || (isAdmin() && request.resource.data.from == 'admin'));
        // Historique immuable.
        allow update, delete: if false;
      }
    }

    // ── Amis ────────────────────────────────────────────────────────────
    // Code ami : permet de retrouver un utilisateur. Lecture unitaire seulement
    // (impossible de lister les codes), création par son propriétaire.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isShortString(request.resource.data.name, 120);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Amitié : créée par l'un des deux, UNIQUEMENT avec le code de l'autre.
    match /friendships/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'code', 'createdAt', 'lastText', 'lastFrom', 'lastAt', 'readAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && pid == pairOf(request.resource.data.members[0], request.resource.data.members[1])
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid != request.auth.uid
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'readAt'])
        && (request.resource.data.get('lastFrom', '') == resource.data.get('lastFrom', '')
            || request.resource.data.lastFrom == request.auth.uid);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && isMessage(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Activité visible par les amis (séance faite aujourd'hui).
    match /activity/{uid} {
      allow read: if isOwner(uid) || isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/friendships/$(pairOf(request.auth.uid, uid))));
      allow write: if ownerActive(uid)
        && request.resource.data.keys().hasOnly(['name', 'day', 'sessionName', 'at']);
    }
  }
}
